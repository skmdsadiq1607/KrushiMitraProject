# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://username:password@cluster.mongodb.net/crop_health_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/crop_health_ai

# JWT Secret Key for Authentication
JWT_SECRET=super_secret_crop_health_jwt_token_2025_college_key

# Groq API Key (For AI Vision and Agriculture Assistant)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Weather API (Optional - Open-Meteo works globally by default with no key needed!)
# Optional OpenWeatherMap API key:
WEATHER_API_KEY=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
